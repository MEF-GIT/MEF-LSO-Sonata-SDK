# MCP server environment variables for a single blended API.
# Update values before starting the docker container.

# Trouble Ticket Management
MCP_OAS_URI=/data/troubleTicket/troubleTicketManagement.api.yaml
MCP_SERVER_URI=https://{serverBase}/mefApi/sonata/troubleTicket/v5/
MCP_BASIC_CREDENTIALS=user:password
MCP_AUTH_MODE=basic
