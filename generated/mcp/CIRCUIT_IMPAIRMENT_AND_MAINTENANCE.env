# MCP server environment variables for a single blended API.
# Update values before starting the docker container.

# Circuit Impairment and Maintenance
MCP_OAS_URI=/data/cim/circuitImpairmentAndMaintenance.api.yaml
MCP_SERVER_URI=https://{serverBase}/mefApi/sonata/cimIncident/v1/
MCP_BASIC_CREDENTIALS=user:password
MCP_AUTH_MODE=basic
