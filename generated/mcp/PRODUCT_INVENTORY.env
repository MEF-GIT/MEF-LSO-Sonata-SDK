# MCP server environment variables for a single blended API.
# Update values before starting the docker container.

# Product Inventory
MCP_OAS_URI=/data/inventory/productInventoryManagement.api.yaml
MCP_SERVER_URI=https://{serverBase}/mefApi/sonata/productInventory/v8/
MCP_BASIC_CREDENTIALS=user:password
MCP_AUTH_MODE=basic
