# MCP server environment variables for a single blended API.
# Update values before starting the docker container.

# Billing Management
MCP_OAS_URI=/data/billing/billingManagement.api.yaml
MCP_SERVER_URI=https://{serverBase}/mefApi/sonata/customerBillManagement/v3/
MCP_BASIC_CREDENTIALS=user:password
MCP_AUTH_MODE=basic
