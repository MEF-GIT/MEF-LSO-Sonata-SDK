# MCP server environment variables for a single blended API.
# Update values before starting the docker container.

# Product Catalog
MCP_OAS_URI=/data/catalog/productCatalog.api.yaml
MCP_SERVER_URI=https://{serverBase}/mefApi/sonata/productCatalog/v4/
MCP_BASIC_CREDENTIALS=user:password
MCP_AUTH_MODE=basic
