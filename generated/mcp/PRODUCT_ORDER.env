# MCP server environment variables for a single blended API.
# Update values before starting the docker container.

# Product Order
MCP_OAS_URI=/data/order/productOrderManagement.api.yaml
MCP_SERVER_URI=https://{serverBase}/mefApi/sonata/productOrderingManagement/v11/
MCP_BASIC_CREDENTIALS=user:password
MCP_AUTH_MODE=basic
