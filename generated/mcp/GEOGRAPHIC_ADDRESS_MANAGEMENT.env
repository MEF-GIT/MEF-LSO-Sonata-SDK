# MCP server environment variables for a single blended API.
# Update values before starting the docker container.

# Geographic Address Management
MCP_OAS_URI=/data/serviceability/address/geographicAddressManagement.api.yaml
MCP_SERVER_URI=https://{serverBase}/mefApi/sonata/geographicAddressManagement/v8/
MCP_BASIC_CREDENTIALS=user:password
MCP_AUTH_MODE=basic
