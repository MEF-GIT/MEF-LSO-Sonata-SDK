@startuml

enum AddressFamilyIpv4Ipv6 {

    IPV4
    IPV6
}
enum AsnType {

    PUBLIC
    PRIVATE
}
class BgpCommunity {

    semantics: string
}

BgpCommunity *--> TwoOctetInteger : autonomousSystemNumber
BgpCommunity *--> TwoOctetInteger : autonomousSystemDefined


class BgpExtendedCommunity {

    semantics: string
}

BgpExtendedCommunity *--> BgpExtendedCommunityType : regularOrExtended


class BgpExtendedCommunityType {

}

BgpExtendedCommunityType *--> BgpRegularType : regular
BgpExtendedCommunityType *--> BgpExtendedType : extended


class BgpExtendedType {

    extendedValue: int64
}

BgpExtendedType *--> TwoOctetInteger : extendedType


class BgpRegularType {

    regularType: integer
    regularValue: int64
}



class BiDirSimpleBandwidth {

}

BiDirSimpleBandwidth *-->"1" InformationRate : downstream
BiDirSimpleBandwidth *-->"1" InformationRate : upstream


enum ConnectorType {

    RJ45
    SC
    LC
    OTHER
}
enum EnabledDisabled {

    ENABLED
    DISABLED
}
class ForwardingInformation {

}

ForwardingInformation *--> Ipv4OrIpv6Address : nextHopIpAddress
ForwardingInformation *--> IdentifierString : uniAccessLink


class FourOctetInteger {

}



class IdentifierString {

}



class InformationRate {

    irValue: number
    irUnits: InformationRateUnits
}



enum InformationRateUnits {

    BPS
    KBPS
    MBPS
    GBPS
    TBPS
    PBPS
    EBPS
    ZBPS
    YBPS
}
class InternetAccess {

    variant*: InternetAccessVariantName
    deliveryMechanism*: InternetAccessDeliveryMechanism
    providerIndependentIpAddresses: EnabledDisabled
    ipAddressType: InternetAccessIpAddressType
}
MEFProductConfiguration <|-- InternetAccess

InternetAccess *-->"*" SubUnit : demarcationPoint
InternetAccess *--> InternetAccessServiceAccessInterfaceType : serviceAccessInterfaceType
InternetAccess *--> VlanIdOrUntagged : vlan
InternetAccess *-->"1" InternetAccessFeatures : features
InternetAccess *-->"1" BiDirSimpleBandwidth : bandwidth
InternetAccess *--> BiDirSimpleBandwidth : guaranteedBandwidth
InternetAccess *--> InternetAccessBillingModel : billingModel
InternetAccess *--> InternetAccessLocalNetworkAddresses : localNetworkAddresses
InternetAccess *--> InternetAccessAutonomousSystemNumber : autonomousSystemNumber
InternetAccess *--> InternetAccessPublicAddressesPrefixLength : publicAddressesPrefixLength
InternetAccess *--> InternetAccessPublicAddressBlock : publicAddressBlock
InternetAccess *--> InternetAccessTransitAddresses : transitAddresses


enum InternetAccessAssistanceLevel {

    SELF_MANAGED
    CO_MANAGED
    FULLY_MANAGED
}
class InternetAccessAutonomousSystemNumber {

    asnType*: AsnType
}

InternetAccessAutonomousSystemNumber *--> FourOctetInteger : asnId


class InternetAccessBgp {

    connectionAddressFamily*: AddressFamilyIpv4Ipv6
    authentication*: string[]
    asOverride: EnabledDisabled
}

InternetAccessBgp *-->"1" FourOctetInteger : subscriberAsNumber
InternetAccessBgp *-->"1" PeeringAddress : peeringAddresses
InternetAccessBgp *-->"*" BgpCommunity : bgpCommunityList
InternetAccessBgp *-->"*" BgpExtendedCommunity : bgpExtendedCommunityList
InternetAccessBgp *--> TwoOctetInteger : holdTime


class InternetAccessBillingModel {

    billingModelType*: InternetAccessBillingModelType
    billingModelPlanName*: string
}



enum InternetAccessBillingModelType {

    FLAT
    BURSTABLE_PERCENTILE
    DATA_TRANSFER
}
enum InternetAccessDeliveryMechanism {

    DEMARCATION_ONLY
    PHYSICAL_ROUTER
    VIRTUAL_ROUTER_REMOTE
    VIRTUAL_ROUTER_LOCAL
}
class InternetAccessDhcpStaticListEntry {

    staticMACAddress: string
}

InternetAccessDhcpStaticListEntry *--> Ipv4OrIpv6Address : staticIpAddress


class InternetAccessFeature {

    isSupported*: boolean
    isEnabled*: boolean
}



class InternetAccessFeatureAssistance {

    assistanceLevel*: InternetAccessAssistanceLevel
    simpleRequestsPerMonth: integer
    complexRequestsPerMonth: integer
}
InternetAccessFeature <|-- InternetAccessFeatureAssistance



class InternetAccessFeatureCloudPrioritization {

    cloudServiceProvider*: string[]
}
InternetAccessFeature <|-- InternetAccessFeatureCloudPrioritization



class InternetAccessFeatureDedicatedFirewall {

    firewallCapability*: InternetAccessFirewallCapability
}
InternetAccessFeature <|-- InternetAccessFeatureDedicatedFirewall



class InternetAccessFeatureDns {

    searchDomain: string[]
}
InternetAccessFeature <|-- InternetAccessFeatureDns



class InternetAccessFeatureLayer3Resiliency {

    layer3Resiliency*: InternetAccessLayer3Resiliency
}
InternetAccessFeature <|-- InternetAccessFeatureLayer3Resiliency



class InternetAccessFeatureMobileBackup {

}
InternetAccessFeature <|-- InternetAccessFeatureMobileBackup

InternetAccessFeatureMobileBackup *-->"1" BiDirSimpleBandwidth : minimumExpectedBandwidth


class InternetAccessFeatureMonitoring {

    monitoringType*: InternetAccessMonitoringType
}
InternetAccessFeature <|-- InternetAccessFeatureMonitoring



class InternetAccessFeatureRouting {

    routingType*: InternetAccessRoutingType
}
InternetAccessFeature <|-- InternetAccessFeatureRouting

InternetAccessFeatureRouting *--> InternetAccessBgp : bgp
InternetAccessFeatureRouting *--> Static : static


class InternetAccessFeatures {

}

InternetAccessFeatures *--> InternetAccessFeatureAssistance : assistance
InternetAccessFeatures *--> InternetAccessFeatureCloudPrioritization : cloudPrioritization
InternetAccessFeatures *--> InternetAccessFeature : ddosMitigation
InternetAccessFeatures *--> InternetAccessFeatureDedicatedFirewall : dedicatedFirewall
InternetAccessFeatures *--> InternetAccessFeatureDns : dns
InternetAccessFeatures *--> InternetAccessFeature : facilityDiversity
InternetAccessFeatures *--> InternetAccessFeatureLayer3Resiliency : layer3Resiliency
InternetAccessFeatures *--> InternetAccessFeatureMobileBackup : mobileBackup
InternetAccessFeatures *--> InternetAccessFeatureMonitoring : monitoring
InternetAccessFeatures *--> InternetAccessFeature : performanceReporting
InternetAccessFeatures *--> InternetAccessFeatureRouting : routing
InternetAccessFeatures *--> InternetAccessFeature : snmpRead


enum InternetAccessFirewallCapability {

    BASIC
    ADVANCED
}
enum InternetAccessIpAddressType {

    STATIC
    DYNAMIC
}
enum InternetAccessIpv4PublicAddressesPrefixLength {

    /24
    /25
    /26
    /27
    /28
    /29
    /30
    /31
    /32
    NONE
}
enum InternetAccessIpv4TransitAddressPrefixLength {

    /24
    /25
    /26
    /27
    /28
    /29
    /30
    /31
    /32
    NONE
}
enum InternetAccessIpv6PublicAddressesPrefixLength {

    /96
    /100
    /104
    /108
    /112
    /116
    /120
    /124
    /128
    NONE
}
enum InternetAccessIpv6TransitAddressPrefixLength {

    /120
    /124
    /128
    NONE
}
enum InternetAccessLayer3Resiliency {

    DUAL_ACCESS_ALL_ACTIVE
    DUAL_ACCESS_ACTIVE_STANDBY
    WIRELESS_BACKUP
}
class InternetAccessLocalNetworkAddresses {

    lanAddressBlock: string
    dhcpStatus*: EnabledDisabled
    natStatus*: EnabledDisabled
}

InternetAccessLocalNetworkAddresses *--> Ipv4OrIpv6Address : dhcpStart
InternetAccessLocalNetworkAddresses *--> Ipv4OrIpv6Address : dhcpEnd
InternetAccessLocalNetworkAddresses *-->"*" InternetAccessDhcpStaticListEntry : dhcpStaticList
InternetAccessLocalNetworkAddresses *--> Ipv4OrIpv6Address : natAddress


enum InternetAccessMonitoringType {

    PROACTIVE
    REACTIVE
}
class InternetAccessPhysicalInterface {

    physicalLayer*: SaiEthernetPhysicalLayer
    connectorType*: ConnectorType
}



class InternetAccessPublicAddressBlock {

    ipv4*: string
    ipv6*: string
}



class InternetAccessPublicAddressesPrefixLength {

    ipv4*: InternetAccessIpv4PublicAddressesPrefixLength
    ipv6*: InternetAccessIpv6PublicAddressesPrefixLength
}



enum InternetAccessResiliency {

    NONE
    ALL_ACTIVE
    2_LINK_ACTIVE_STANDBY
    OTHER
}
enum InternetAccessRoutingType {

    BGP
    STATIC
}
class InternetAccessServiceAccessInterfaceType {

    resiliency*: InternetAccessResiliency
}

InternetAccessServiceAccessInterfaceType *-->"1..*" InternetAccessPhysicalInterface : physicalInterface


class InternetAccessTransitAddresses {

    requestedIpv4TransitAddressPrefixLength: InternetAccessIpv4TransitAddressPrefixLength
    requestedIpv6TransitAddressPrefixLength: InternetAccessIpv6TransitAddressPrefixLength
    serviceProviderIpv4TransitAddress: string
    serviceProviderIpv6TransitAddress: string
}



enum InternetAccessVariantName {

    BROADBAND_BASIC
    BROADBAND_ADVANCED
    DEDICATED_WITHOUT_ROUTER
    DEDICATED_WITH_ROUTER
}
class Ipv4Address {

}



class Ipv4OrIpv6Address {

}

Ipv4OrIpv6Address *--> Ipv4Address : ipv4Address
Ipv4OrIpv6Address *--> Ipv6Address : ipv6Address


class Ipv4OrIpv6Prefix {

}

Ipv4OrIpv6Prefix *--> Ipv4Prefix : ipv4Prefix
Ipv4OrIpv6Prefix *--> Ipv6Prefix : ipv6Prefix


class Ipv4Prefix {

    prefixLength: integer
}

Ipv4Prefix *--> Ipv4Address : ipv4Address


class Ipv6Address {

}



class Ipv6Prefix {

    prefixLength: integer
}

Ipv6Prefix *--> Ipv6Address : ipv6Address


class MEFProductConfiguration {

    @type*: string
}



class PeeringAddress {

    peeringAddressType: PeeringAddressType
}

PeeringAddress *-->"*" SubscriberAndSpLoopbackAddresses : subscriberAndSpLoopbackAddresses


enum PeeringAddressType {

    CONNECTION_ADDRESSES
    LOOPBACKS
}
