    1000BASE-LX10
    1000BASE-SX
    1000BASE-T
    100BASE-BX10
    100BASE-FX
    100BASE-LX10
    100BASE-SR10
    100BASE-SX
    100BASE-TX
    100GBASE-CR1
    100GBASE-CR10
    100GBASE-CR2
    100GBASE-CR4
    100GBASE-DR
    100GBASE-ER4
    100GBASE-FR1
    100GBASE-LR1
    100GBASE-LR4
    100GBASE-SR2
    100GBASE-SR4
    100GBASE-ZR
    200GBASE-CR2
    200GBASE-CR4
    200GBASE-DR4
    200GBASE-ER4
    200GBASE-FR4
    200GBASE-LR4
    200GBASE-SR4
    25GBASE-CR
    25GBASE-ER
    25GBASE-LR
    25GBASE-SR
    25GBASE-T
    2.5GBASE-T
    40GBASE-CR4
