class TimeSlot {

}

TimeSlot *-->"1" TimePeriod : validFor


class MEFByteSize {

    amount: float
    units: DataSizeUnit
}



class Note {

    author*: string
    date*: date-time
    id*: string
    source*: MEFBuyerSellerType
    text*: string
}



class SearchTimeSlot {

}

SearchTimeSlot *-->"1..*" TimeSlot : availableTimeSlot
