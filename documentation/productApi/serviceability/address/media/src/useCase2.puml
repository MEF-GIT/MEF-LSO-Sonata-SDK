@startuml

hide footbox

participant Buyer
participant Seller

Buyer -> Seller : GET {{baseUrl}}/geographicAddressValidation/{id}

Seller -> Seller : validate Request

alt success
    Buyer <-- Seller : 200 GeographicAddressValidation (with current state)
else validation or internal problem
    Buyer <-- Seller: 4xx/5xx : error response
end
@enduml