@startuml

class Quote_Common {

    requestedQuoteCompletionDate: date-time
    description: string
    externalId: string
    buyerRequestedQuoteLevel*: MEFBuyerQuoteLevel
    projectId: string
    instantSyncQuote*: boolean
    note: Note
}

Quote_Common *-->"*" RelatedContactInformation : relatedContactInformation




class MEFProductConfiguration {

    @type*: string 
}
class MEFProductRefOrValueQuote {

    id: string
    href: string
}

MEFProductRefOrValueQuote *-->"*" RelatedPlaceRefOrQueryWithSubUnit : place
MEFProductRefOrValueQuote *--> MEFProductConfiguration : productConfiguration
MEFProductRefOrValueQuote *--> ProductOfferingRef : productOffering
MEFProductRefOrValueQuote *-->"*" ProductRelationship : productRelationship


class MEFQuoteItem_Common {

    id*: string
    action*: MEFProductActionType
    agreementName: string
    dealReference: string
    note: Note
    productOfferingQualificationItem: ProductOfferingQualificationItemRef
    requestedQuoteItemInstallationInterval: Duration
    requestedQuoteItemTerm: MEFItemTerm
}

MEFQuoteItem_Common *-->"1" MEFProductRefOrValueQuote : product
MEFQuoteItem_Common *-->"*" RelatedContactInformation : relatedContactInformation
MEFQuoteItem_Common *-->"*" QuoteItemRelationship : quoteItemRelationship


class ProductOfferingRef {

    id*: string 
    href: string 
}


class ProductRelationship {

    href: string
    id*: string
    relationshipType*: string
}


class Quote {

    id*: string 
    href: string 
    effectiveQuoteCompletionDate: date-time 
    expectedQuoteCompletionDate: date-time 
    quoteDate*: date-time 
    quoteLevel: MEFSellerQuoteLevel 
    state: MEFQuoteStateType
    stateChange*: MEFQuoteStateChange[]
    validFor: TimePeriod
}
Quote_Common <|-- Quote

Quote *-->"1..*" QuoteItem : quoteItem

class QuoteItem {

    subjectToFeasibilityCheck: boolean 
    state*: MEFQuoteItemStateType 
    stateChange*: MEFQuoteItemStateChange[]
    terminationError: TerminationError
    quoteItemInstallationInterval: Duration 
    quoteItemTerm: MEFItemTerm
}
MEFQuoteItem_Common <|-- QuoteItem

QuoteItem *-->"*" QuotePrice : quoteItemPrice

class QuoteItemRelationship {

    id*: string 
    relationshipType*: string 
}

class QuotePrice {

    unitOfMeasure: string
    name*: string
    priceType*: MEFPriceType
    description: string
    recurringChargePeriod: Duration
}

QuotePrice *-->"1" Price : price

class RelatedContactInformation {

    role*: string
    number*: string
    emailAddress*: string
    organization: string
    name*: string
    numberExtension: string
    postalAddress: FieldedAddressRepresentation
}

class RelatedPlaceRefOrQueryWithSubUnit {

    role*: string
    place: PlaceRefOrQuery
    subUnit: SubUnit
    contact: ContactInformation
}




class Money {

    unit*: string 
    value*: float 
}


class Price {

    taxRate: float
}

Price *--> Money : taxIncludedAmount
Price *-->"1" Money : dutyFreeAmount



@enduml
