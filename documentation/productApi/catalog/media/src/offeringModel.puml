@startuml

class ProductOffering_Common {

    id: string
    href: uri
    name: string
    description: string
    lastUpdate: date-time
    lifecycleStatus: ProductOfferingLifecycleStatusType
    agreement: string
    isBundle: boolean
    isSellable: boolean
    channel: string[]
    marketSegment: string[]
}

ProductOffering_Common *-->"*" Region : region
ProductOffering_Common *-->"*" ProductCategoryRef : category
ProductOffering_Common *--> ProductSpecificationRef : productSpecification

class ProductOffering {

    statusReason: string
}
ProductOffering_Common <|-- ProductOffering

ProductOffering *-->"*" ProductOfferingLifecycleStatusTransition : statusTransition
ProductOffering *-->"*" AttachmentValue : attachment
ProductOffering *--> RelatedContactInformation : relatedContactInformation
ProductOffering *-->"*" ProductOfferingTerm : productOfferingTerm
ProductOffering *-->"*" ProductMilestoneDefinition : milestone
ProductOffering *-->"*" ProductOfferingBundleRelationship : bundledProductOffering
ProductOffering *-->"*" Note : note
ProductOffering *--> SchemaRefOrValue : productOfferingSpecificationSchema
ProductOffering *-->"*" ProductOfferingContextualInfo : productOfferingContextualInfo
ProductOffering *-->"*" ProductRelationshipConstraint : productRelationshipConstraint
ProductOffering *-->"*" PlaceRelationshipConstraint : placeRelationshipConstraint


class ProductOfferingBundleRelationship {
    isModifiable*: boolean
    minCardinality*: integer
    maxCardinality*: integer
}

ProductOfferingBundleRelationship *-->"1" ProductOfferingRef : productOffering

class ProductRelationshipConstraint {

    productSpecification*: string
    relationshipType*: string
    isModifiable*: boolean
    minCardinality*: integer
    maxCardinality*: integer
}

class PlaceRelationshipConstraint {

    relationshipRole*: string
    isModifiable*: boolean
    minCardinality*: integer
    maxCardinality*: integer
}


class ProductOfferingPrice {

    description*: string
    lastUpdate*: date-time
    priceType*: MEFPriceType
    unitOfMeasure: string
}

ProductOfferingPrice *-->"1" TimePeriod : validFor
ProductOfferingPrice *--> ProductOfferingRef : bundledProductOffering
ProductOfferingPrice *-->"*" Region : region
ProductOfferingPrice *-->"*" Note : note
ProductOfferingPrice *--> Duration : recurringChargePeriod
ProductOfferingPrice *-->"1" Price : price
ProductOfferingPrice *-->"*" PriceModifier : priceModifier


class PriceModifier {

    description*: string
    lastUpdate*: date-time
    minimumQuantity*: integer
    reductionPercentage: number
    dealReference: string
}

PriceModifier *-->"1" TimePeriod : validFor
PriceModifier *-->"*" Region : region
PriceModifier *--> Price : discountedPrice



class ProductMilestoneDefinition {

    name*: string
    description*: string
}




class TimePeriod {

    startDateTime: date-time
    endDateTime: date-time
}


class ProductOfferingRef {

    id*: string
    href: uri
}


class ProductCategoryRef {
    id*: string
    href: string
}

class Region {

    city: string
    locality: string
    stateOrProvince: string
    countryCode*: string
}




class Price {

    taxRate: float
}

Price *--> Money : taxIncludedAmount
Price *-->"1" Money : dutyFreeAmount

class Money {

    unit*: string
    value*: float
}

class AttachmentValue {

    author*: string
    creationDate*: date-time
    description: string
    mimeType: string
    name*: string
    source*: MEFBuyerSellerType
    url*: string
}
AttachmentValue *--> MEFByteSize : size

class MEFByteSize {

    amount*: float
    units*: DataSizeUnit
}
class ProductOfferingLifecycleStatusTransition {

    transitionDate*: date-time
    lifecycleStatus*: ProductOfferingLifecycleStatusType
    statusReason: string
}




class RelatedContactInformation {

    emailAddress*: string
    name*: string
    number*: string
    numberExtension: string
    organization: string
    role*: string
}

RelatedContactInformation *--> FieldedAddressRepresentation : postalAddress


class FieldedAddressRepresentation {

    streetNr: string
    streetNrSuffix: string
    streetNrLast: string
    streetNrLastSuffix: string
    streetPreDirection: string
    streetName: string
    streetType: string
    streetPostDirection: string
    poBox: string
    locality: string
    city: string
    postcode: string
    postcodeExtension: string
    stateOrProvince: string
    countryCode: string
    buildingName: string
    privateStreetNumber: string
    privateStreetName: string
    language: string
}


class SubUnit {

    subUnitNumber*: string
    subUnitType*: string
}
FieldedAddressRepresentation *-->"*" SubUnit : subUnit

class MEFItemTerm {

    name*: string
    description: string
    endOfTermAction*: MEFEndOfTermAction
}

MEFItemTerm *-->"1" Duration : duration
MEFItemTerm *--> Duration : rollInterval


class ProductOfferingTerm {

}
MEFItemTerm <|-- ProductOfferingTerm

ProductOfferingTerm *-->"*" ProductOfferingPrice : productOfferingPrice


class Duration {
    amount*: number
    units*: TimeUnit
}

class Note {

    author*: string
    date*: date-time
    id*: string
    source*: MEFBuyerSellerType
    text*: string
}

class ProductSpecificationRef {
    id*: string
    href: string
}

class ProductOfferingContextualInfo {

}

ProductOfferingContextualInfo *-->"1" SchemaRefOrValue : contextSchema
ProductOfferingContextualInfo *-->"1" Context : context


class Context {

    productAction: ProductActionMask
    businessFunction: BusinessFunctionMask
}

class SchemaRefOrValue {

    schema: string
    schemaLocation: uri
}


@enduml
