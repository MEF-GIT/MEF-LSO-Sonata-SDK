@startuml

class Duration {

    amount*: integer
    units*: TimeUnit
}


enum MEFEndOfTermAction {

    roll
    autoDisconnect
    autoRenew
}
class MEFItemTerm {

    endOfTermAction*: MEFEndOfTermAction
    name*: string
    description: string
}

MEFItemTerm *-->"1" Duration : duration
MEFItemTerm *--> Duration : rollInterval


enum MEFPriceType {

    recurring
    nonRecurring
    usageBased
}
class Money {

    unit*: string
    value*: float
}



class Price {

    taxRate: float
}

Price *--> Money : taxIncludedAmount
Price *-->"1" Money : dutyFreeAmount


class PricingAndTerm {

    identifier*: string
    subjectToAdditionalNonrecurringCharges*: boolean
}

PricingAndTerm *-->"1" Duration : installationInterval
PricingAndTerm *-->"1" MEFItemTerm : term
PricingAndTerm *-->"1..*" QuotePrice : price

class PricingDiscovery {

}
PricingDiscovery_Request <|-- PricingDiscovery

PricingDiscovery *-->"1..*" PricingAndTerm : pricingAndTerm


class PricingDiscovery_Request {

    action*: ProductActionAddModifyType
    productOfferingConfigurationIdentifier*: string
}

PricingDiscovery_Request *--> ProductRef : productRef
PricingDiscovery_Request *-->"*" ProductRelationship : productRelationship
PricingDiscovery_Request *-->"*" RelatedPlaceRefWithSubUnit : place


enum ProductActionAddModifyType {

    add
    modify
}


class ProductRef {

    id*: string
    href: string
}



class ProductRelationship {

    href: string
    id*: string
    relationshipType*: string
}


class QuotePrice {

    name*: string
    description: string
    priceType*: MEFPriceType
    unitOfMeasure: string
}

QuotePrice *--> Duration : recurringChargePeriod

QuotePrice *-->"1" Price : price



enum TimeUnit {

    seconds
    minutes
    businessHours
    calendarHours
    businessDays
    calendarDays
    months
    years
}


class GeographicAddressRef {

    href: string
    id*: string
    @type*: string
}




class GeographicSiteRef {

    href: string
    id*: string
    @type*: string
}



class RelatedPlaceRefWithSubUnit {

    role*: string
}

RelatedPlaceRefWithSubUnit *-->"1" PlaceRef : place
RelatedPlaceRefWithSubUnit *-->"*" SubUnit : subUnit


class SubUnit {

    subUnitNumber*: string
    subUnitType*: string
}


class PlaceRef {
    --
    discriminator:
    GeographicAddressRef
    GeographicSiteRef
}
PlaceRef ..> GeographicAddressRef : """"
PlaceRef ..> GeographicSiteRef : """"
@enduml
