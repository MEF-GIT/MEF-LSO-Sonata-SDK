@startuml

class Duration {

    amount*: integer
    units*: TimeUnit
}


class MEFProductConfiguration {

    @type*: string
}



enum ProductActionAddModifyType {

    add
    modify
}
class ProductOfferingAvailability {

}
ProductOfferingAvailability_Request <|-- ProductOfferingAvailability

ProductOfferingAvailability *-->"1..*" ProductOfferingConfiguration : availableProductOfferingConfiguration


class ProductOfferingAvailability_Request {

    action*: ProductActionAddModifyType
}

ProductOfferingAvailability_Request *--> ProductSpecificationRef : productSpecification
ProductOfferingAvailability_Request *--> ProductRef : productRef
ProductOfferingAvailability_Request *-->"*" ProductRelationship : productRelationship
ProductOfferingAvailability_Request *-->"*" RelatedPlaceRefWithSubUnit : place


class ProductOfferingConfiguration {

    productOfferingConfigurationIdentifier*: string
}

ProductOfferingConfiguration *-->"1" ProductOfferingRef : productOffering
ProductOfferingConfiguration *-->"1" MEFProductConfiguration : productConfiguration
ProductOfferingConfiguration *-->"1" Duration : installationInterval


class ProductOfferingRef {

    href: string
    id*: string
}



class ProductRef {

    id*: string
    href: string
}



class ProductRelationship {

    href: string
    id*: string
    relationshipType*: string
}



class ProductSpecificationRef {

    href: string
    id*: string
}



enum TimeUnit {

    seconds
    minutes
    businessHours
    calendarHours
    businessDays
    calendarDays
    months
    years
}


class GeographicAddressRef {

    href: string
    id*: string
    @type*: string
}




class GeographicSiteRef {

    href: string
    id*: string
    @type*: string
}



class RelatedPlaceRefWithSubUnit {

    role*: string
}

RelatedPlaceRefWithSubUnit *-->"1" PlaceRef : place
RelatedPlaceRefWithSubUnit *-->"*" SubUnit : subUnit


class SubUnit {

    subUnitNumber*: string
    subUnitType*: string
}


class PlaceRef {
    --
    discriminator:
    GeographicAddressRef
    GeographicSiteRef
}
PlaceRef ..> GeographicAddressRef : """"
PlaceRef ..> GeographicSiteRef : """"
@enduml
